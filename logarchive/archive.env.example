# The settings of the log archive, which compose.production.example.yml loads into the log-archive container only. Copy this file to
# logarchive/.env.archive, which git ignores, and fill it in. It is not in .env because every API container loads all of .env, and the key
# of the archive must not be there. See docs/monitoring.md.

# The private bucket that takes the logs.
LOG_ARCHIVE_BUCKET=
# The address of the store, https://<account>.r2.cloudflarestorage.com for Cloudflare R2 or https://s3.<region>.amazonaws.com for AWS S3.
LOG_ARCHIVE_ENDPOINT=
LOG_ARCHIVE_ACCESS_KEY_ID=
LOG_ARCHIVE_ACCESS_KEY_SECRET=
# The region of the store, auto for Cloudflare R2 and the region of the bucket for every other store. A wrong region is refused by AWS S3.
LOG_ARCHIVE_REGION=auto
