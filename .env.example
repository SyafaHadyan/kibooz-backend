# Kibooz backend settings. Copy this file to .env and fill in the values marked REQUIRED.
#
# How to read it
#   - A line that holds a value shows the default of that setting, or a sample value where it is marked REQUIRED.
#   - A line that starts with # and holds a name and a value is optional and off until you remove the #.
#   - REQUIRED means there is no usable default, so put in a value of your own.
#   - Write NAME=value with no spaces around the equals sign and no quotes, and keep comments on their own lines.
#   - The file is read by the API and by the bundled compose files. Never commit the filled in file.

# ----------------------------------------------------------------------------------------------------------------------
# Server
# ----------------------------------------------------------------------------------------------------------------------
APP_PORT=8080
APP_TIMEZONE=Asia/Jakarta
REQUEST_TIMEOUT_SECONDS=10
# The largest request body. A video file goes straight to the bucket through a signed address, so it does not count against it.
BODY_LIMIT_MB=8

# Set TRUST_PROXY=true only behind a reverse proxy that sets PROXY_HEADER.
TRUST_PROXY=false
PROXY_HEADER=X-Forwarded-For

# METRICS_ADDRESS is where the Prometheus endpoint listens, for example :9100. Empty switches it off. It is a second listener that
# only serves GET /metrics, with route names, error counts and pool sizes, so it must stay on the private network of the scraper.
# METRICS_ADDRESS=

# ----------------------------------------------------------------------------------------------------------------------
# Database (PostgreSQL)
# ----------------------------------------------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
# REQUIRED. DB_NAME, DB_USERNAME and DB_PASSWORD have no default in the API, so replace the sample values.
DB_NAME=kibooz
DB_USERNAME=kibooz
DB_PASSWORD=change-me
DB_SSL_MODE=disable

# ----------------------------------------------------------------------------------------------------------------------
# Redis
# ----------------------------------------------------------------------------------------------------------------------
REDIS_ADDRESS=127.0.0.1
REDIS_PORT=6379
REDIS_TLS=false
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0
# Put this before every key when other applications use the same Redis, for example kibooz:
REDIS_KEY_PREFIX=
LEADERBOARD_CACHE_SECONDS=300

# Seconds between a small query to the database and a PING to Redis, so hosted instances that pause when idle stay awake. Set 0 to
# disable.
KEEPALIVE_SECONDS=60

# ----------------------------------------------------------------------------------------------------------------------
# Sessions and passwords
# ----------------------------------------------------------------------------------------------------------------------
# REQUIRED. At least 32 characters. The sample value below is refused at startup, so a copied file cannot run with a public secret.
JWT_SECRET_KEY=change-me-to-a-random-string-of-32-chars-or-more
JWT_ACCESS_EXPIRED_MINUTES=15
JWT_REFRESH_EXPIRED_DAYS=30
# A session ends this many days after the sign in, however often its token is refreshed.
JWT_SESSION_MAX_DAYS=90
# A refresh token that is shown again within this many seconds of its use gets a new token of the same session, for an app that lost
# the answer to its first call. Later the reuse ends the whole session. 0 switches it off and the highest value is 60.
REFRESH_REUSE_LEEWAY_SECONDS=10
# A device that sends this token at login has its own rate limit for the email.
DEVICE_TOKEN_TTL_DAYS=90

# Hashing a password takes tens of milliseconds of a whole CPU, and sign in and sign up are open to anyone. Only this many
# passwords are hashed or checked at once. 0 is one less than the number of CPUs the Go runtime may use (GOMAXPROCS) and never
# less than one, so a CPU stays free for everything else. A request that finds every slot taken waits up to
# PASSWORD_HASH_WAIT_MILLISECONDS and then gets 429 with a Retry-After, so a flood cannot keep every CPU busy.
PASSWORD_HASH_CONCURRENCY=0
PASSWORD_HASH_WAIT_MILLISECONDS=1000
# The bcrypt cost of new password hashes, from 4 to 14. Every step doubles the time of a hash. 10 is the default of bcrypt and the
# lowest value that OWASP accepts, so a lower one is for tests only and the server logs a warning. Hashes that already exist
# keep the cost they were made with.
PASSWORD_HASH_COST=10

# ----------------------------------------------------------------------------------------------------------------------
# Rate limits
# ----------------------------------------------------------------------------------------------------------------------
# Requests are counted in a sliding window that is shared through Redis. The limits never look at the IP address, because many
# people share one public address on a school network or an ISP.
LIMITER_EXPIRATION_SECONDS=60
# The allowance of each signed-in user.
USER_LIMITER_MAX=120
# The allowance per account for login, register, refresh and logout, and per user for deleting an account.
AUTH_LIMITER_MAX=10
# The allowance of each route for requests that name a class code, shared by every caller of that route, so guessing a code is
# limited by the number of guesses and not by who sends them. A school that signs up its parents at once needs room for them.
CLASS_CODE_LIMITER_MAX=60
# The allowance of each user for the batch mood route, on top of USER_LIMITER_MAX. One batch holds up to 30 logs.
MOOD_BATCH_LIMITER_MAX=30

# ----------------------------------------------------------------------------------------------------------------------
# Object storage for avatars, trash photos and class videos
# ----------------------------------------------------------------------------------------------------------------------
# Leave it empty to disable uploads. Cloudflare R2 only needs S3_ACCOUNT_ID, and any other S3 compatible server needs S3_ENDPOINT.
S3_ACCOUNT_ID=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_ACCESS_KEY_SECRET=
# The public bucket, and the address that serves its objects to anyone, because the app plays and shows them from there.
# Add a lifecycle rule that expires the pending/ prefix after one day, and never one that covers videos/. A video that a teacher
# uploads waits under pending/ until it is added to a class, and the rule removes the ones that never are.
S3_PUBLIC_BUCKET_NAME=
S3_PUBLIC_URL=
# The largest video a teacher may announce for a class. The signed upload address of a class video and of a chat video works for
# VIDEO_UPLOAD_URL_SECONDS.
CLASS_VIDEO_MAX_MB=100
VIDEO_UPLOAD_URL_SECONDS=900

# ----------------------------------------------------------------------------------------------------------------------
# Chat
# ----------------------------------------------------------------------------------------------------------------------
# The photos and videos of the chat go to a second bucket that is never public, and the app reads them through signed addresses.
# It uses the same account and keys as the bucket above, so the key has to cover both. It needs the same lifecycle rule on pending/,
# and never one on chat/. Leave it empty to switch chat photos and videos off.
S3_PRIVATE_BUCKET_NAME=
# The largest file of each kind, and how long a signed read address works. The photo limit has to stay below BODY_LIMIT_MB.
CHAT_PHOTO_MAX_MB=4
CHAT_VIDEO_MAX_MB=25
CHAT_MEDIA_URL_SECONDS=3600

# The chat socket pushes new messages to the app. CHAT_MAX_SOCKETS is how many sockets one API copy holds, and each takes some
# memory, so keep it below what the memory cap of the container allows. CHAT_MAX_SOCKETS_PER_USER is how many sockets one account
# keeps open.
CHAT_MAX_SOCKETS=1000
CHAT_MAX_SOCKETS_PER_USER=5

# A photo upload holds the body, a decoded copy and the cleaned copy in memory at once. This many photo uploads (the avatar, a scan
# claim and a chat photo) are handled at the same time by one API copy, and the next one gets 429 with a Retry-After. Keep it low
# for a small memory cap. A request with a body of 64 KB or less holds no photo and never takes a slot. The gate bounds the work after the
# body arrives and not the bodies themselves, so limit the connections to the upload routes in the proxy as well.
UPLOAD_CONCURRENCY=4

# How many of those one account may have running in one API copy, so a client that loops cannot take every slot from the others. The
# next upload of that account gets 429 with a Retry-After and the message that a photo of the account is still being received.
UPLOAD_CONCURRENCY_PER_ACCOUNT=2

# The key file of the Firebase service account, which lets the server wake a closed app when a chat message arrives. The push carries
# the ids of the conversation and the message and no text. Leave it empty to switch the pushes off. The file has to be readable by
# the container, so mount it read only and keep it out of the repository and the image.
FIREBASE_CREDENTIALS_FILE=

# ----------------------------------------------------------------------------------------------------------------------
# Game rules
# ----------------------------------------------------------------------------------------------------------------------
POINTS_ORGANIK=10
POINTS_ANORGANIK=15
POINTS_B3=0
TRASH_DAILY_LIMIT=5
# The months in which a semester begins, as numbers from 1 to 12 separated by commas. On the first day of each of them, in
# APP_TIMEZONE, the leaderboard of every class starts from zero. The points of all semesters stay.
SEMESTER_START_MONTHS=1,7
# How long the server remembers an Idempotency-Key, so a client that was offline for a few days can still repeat a queued action
# safely. The keys are small, and rows older than this are deleted every hour.
IDEMPOTENCY_TTL_HOURS=168

# ----------------------------------------------------------------------------------------------------------------------
# Error reports (Sentry)
# ----------------------------------------------------------------------------------------------------------------------
# A 5xx and a panic are sent to Sentry with the error text, the stack, the route pattern, the status, the request id and the account
# id, scrubbed of emails, tokens and long numbers, and never with a request body, a header or a cookie. An empty SENTRY_DSN
# switches the reports off. The DSN is a secret in practice, so keep it in this file only. SENTRY_EVENTS_PER_MINUTE is the most
# events that leave in a minute, which keeps a crash loop from using the monthly quota. See docs/adr/0006-sentry-error-reports.md.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_SERVER_NAME=sora
# SENTRY_EVENTS_PER_MINUTE=30

# ----------------------------------------------------------------------------------------------------------------------
# Docker Compose only, these are not read by the API itself
# ----------------------------------------------------------------------------------------------------------------------
# The tag of the API image that compose.yml runs. The default latest moves with every push to main, so name a release such as
# 0.6.0 to stay on it.
# IMAGE_TAG=latest
# GOMEMLIMIT is a soft limit for the Go runtime, so keep it below the memory of the API container. REDIS_MAXMEMORY caps the bundled
# Redis, and only keys with an expiry are evicted when it is full.
GOMEMLIMIT=200MiB
REDIS_MAXMEMORY=96mb
# API_MEMORY_LIMIT and REDIS_MEMORY_LIMIT are hard caps of the two containers, and the database has none. Keep API_MEMORY_LIMIT above
# GOMEMLIMIT and REDIS_MEMORY_LIMIT above REDIS_MAXMEMORY.
# API_MEMORY_LIMIT=384m
# REDIS_MEMORY_LIMIT=192m
# ALLOY_MEMORY_LIMIT is the hard cap of the Alloy container, which only runs with the monitoring profile.
# ALLOY_MEMORY_LIMIT=256m
# LOG_ARCHIVE_MEMORY_LIMIT is the hard cap of the Vector container that archives the logs, which only runs with the log-archive profile.
# LOG_ARCHIVE_MEMORY_LIMIT=128m
# BUCKET_SIZES_MEMORY_LIMIT is the hard cap of the exporter of the bucket sizes, which only runs with the bucket-sizes profile.
# BUCKET_SIZES_MEMORY_LIMIT=64m
# BUCKET_SIZES_GOMEMLIMIT is the soft limit of the Go runtime in that container, keep it below BUCKET_SIZES_MEMORY_LIMIT.
# BUCKET_SIZES_GOMEMLIMIT=48MiB
# CPU caps of the two copies of the API and of Redis in compose.production.example.yml, and how long Docker waits for an API copy to stop
# (the API needs 32 seconds at most).
# API_CPUS=0.50
# REDIS_CPUS=0.50
# API_STOP_GRACE_PERIOD=40s
# The ports of the two API copies on the host, which only the reverse proxy reaches. scripts/rolling-update.sh reads them from COPIES
# (api-1:8000 api-2:8001 by default), so give COPIES the same ports when you change them here.
# API_1_HOST_PORT=8000
# API_2_HOST_PORT=8001
# The port of the Prometheus listener of the API copies and of the bucket size exporter. Compose passes each one to the program and to
# the label that Alloy uses to find it, so a change here moves both.
# METRICS_PORT=9100
# BUCKET_SIZES_PORT=9101
# How big a log file of a container gets and how many are kept before the oldest is removed.
# LOG_MAX_SIZE=10m
# LOG_MAX_FILES=5

# ----------------------------------------------------------------------------------------------------------------------
# Monitoring (Grafana Cloud through Alloy)
# ----------------------------------------------------------------------------------------------------------------------
# Alloy and its Docker socket proxy start only when COMPOSE_PROFILES holds monitoring. The values come from the Grafana Cloud stack,
# and GRAFANA_CLOUD_TOKEN is an access policy token that has the metrics:write and logs:write scopes. See docs/monitoring.md.
# The bucket-sizes profile adds the exporter of the bucket sizes, which only makes sense next to monitoring, see logarchive and bucketsizes.
# COMPOSE_PROFILES=monitoring
# GRAFANA_CLOUD_PROMETHEUS_URL=https://prometheus-prod-00-prod-ap-southeast-0.grafana.net/api/prom/push
# GRAFANA_CLOUD_PROMETHEUS_USER=
# GRAFANA_CLOUD_LOKI_URL=https://logs-prod-000.grafana.net/loki/api/v1/push
# GRAFANA_CLOUD_LOKI_USER=
# GRAFANA_CLOUD_TOKEN=
# The name of this host on every metric and log line. Give each host that runs the stack its own name and keep it.
# GRAFANA_HOST=main

# ----------------------------------------------------------------------------------------------------------------------
# Log archive (any S3 compatible bucket through Vector)
# ----------------------------------------------------------------------------------------------------------------------
# Vector and the Docker socket proxy start when COMPOSE_PROFILES holds log-archive, and the profiles are separated by a comma when
# monitoring runs too. The bucket, its address, its region and its key are not here but in logarchive/.env, which only the
# archive container loads, see logarchive/.env.example and docs/monitoring.md.
# The name of this host in the keys and in every line, which is GRAFANA_HOST when it is empty.
# LOG_ARCHIVE_HOST=main
