APP_ENV=production
APP_PORT=8080
APP_TIMEZONE=Asia/Jakarta
BODY_LIMIT_MB=8

# Rate limiting per IP, shared through Redis
LIMITER_MAX=90
LIMITER_EXPIRATION_SECONDS=60
AUTH_LIMITER_MAX=10

# Set TRUST_PROXY=true only behind a reverse proxy that sets PROXY_HEADER
TRUST_PROXY=false
PROXY_HEADER=X-Forwarded-For

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=kibooz
DB_USERNAME=kibooz
DB_PASSWORD=change-me
DB_SSL_MODE=disable

REDIS_ADDRESS=127.0.0.1
REDIS_PORT=6379
REDIS_TLS=false
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0
LEADERBOARD_CACHE_SECONDS=300

# Must be at least 32 characters
JWT_SECRET_KEY=change-me-to-a-random-string-of-32-chars-or-more
JWT_ACCESS_EXPIRED_MINUTES=60
JWT_REFRESH_EXPIRED_DAYS=30

# Object storage for avatars and trash photos, leave empty to disable uploads
# Cloudflare R2 only needs S3_ACCOUNT_ID, any other S3 compatible server needs S3_ENDPOINT
S3_ACCOUNT_ID=
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_ACCESS_KEY_SECRET=
S3_PUBLIC_URL=

# Gamification rules
POINTS_ORGANIK=10
POINTS_ANORGANIK=15
POINTS_B3=0
TRASH_DAILY_LIMIT=5
