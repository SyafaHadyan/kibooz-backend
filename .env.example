APP_PORT=8080
# METRICS_ADDRESS is where the Prometheus endpoint listens, for example :9100. Empty switches it off. It is a second listener that
# only serves GET /metrics, with route names, error counts and pool sizes, so it must stay on the private network of the scraper.
# METRICS_ADDRESS=
APP_TIMEZONE=Asia/Jakarta
BODY_LIMIT_MB=8
REQUEST_TIMEOUT_SECONDS=10
# A video file goes straight to the bucket through a signed address, so it does not count against BODY_LIMIT_MB.
# VIDEO_MAX_MB is the largest video a teacher may announce and VIDEO_UPLOAD_URL_SECONDS is how long the signed address works.
VIDEO_MAX_MB=100
VIDEO_UPLOAD_URL_SECONDS=900

# Rate limits count requests in a sliding window, shared through Redis. They never look at the IP address,
# because many people share one public address on a school network or an ISP.
# USER_LIMITER_MAX is the allowance of each signed-in user
USER_LIMITER_MAX=120
LIMITER_EXPIRATION_SECONDS=60
# AUTH_LIMITER_MAX is the allowance per account for login, register, refresh and logout, and per user for deleting an account
AUTH_LIMITER_MAX=10
# CLASS_CODE_LIMITER_MAX is the allowance of each route for requests that name a class code, shared by every caller of that
# route, so guessing a code is limited by the number of guesses and not by who sends them. A school that signs up its parents at once needs room for them
CLASS_CODE_LIMITER_MAX=60
# MOOD_BATCH_LIMITER_MAX is the allowance of each user for the batch mood route, on top of USER_LIMITER_MAX. One batch holds up to 30 logs
MOOD_BATCH_LIMITER_MAX=30

# Hashing a password takes tens of milliseconds of a whole CPU, and sign in and sign up are open to anyone. Only this many
# passwords are hashed or checked at once, 0 is one for each CPU except one, which stays
# free for everything else. A request that finds every slot taken waits up to
# PASSWORD_HASH_WAIT_MILLISECONDS and then gets 429 with a Retry-After, so a flood cannot keep every CPU busy
PASSWORD_HASH_CONCURRENCY=0
PASSWORD_HASH_WAIT_MILLISECONDS=1000

# Set TRUST_PROXY=true only behind a reverse proxy that sets PROXY_HEADER
TRUST_PROXY=false
PROXY_HEADER=X-Forwarded-For

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=kibooz
DB_USERNAME=kibooz
DB_PASSWORD=change-me
DB_SSL_MODE=disable

REDIS_ADDRESS=127.0.0.1
REDIS_PORT=6379
REDIS_TLS=false
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0
# Put this before every key when other applications use the same Redis, for example kibooz:
REDIS_KEY_PREFIX=
LEADERBOARD_CACHE_SECONDS=300

# Only read by the bundled compose files
# GOMEMLIMIT is a soft limit for the Go runtime, so keep it below the memory of the API container
# REDIS_MAXMEMORY caps the bundled Redis, only keys with an expiry are evicted when it is full
GOMEMLIMIT=200MiB
REDIS_MAXMEMORY=96mb
# API_MEMORY_LIMIT and REDIS_MEMORY_LIMIT are hard caps of the two containers, the database has none. Keep API_MEMORY_LIMIT above GOMEMLIMIT and REDIS_MEMORY_LIMIT above REDIS_MAXMEMORY
# API_MEMORY_LIMIT=384m
# REDIS_MEMORY_LIMIT=192m
# IMAGE_TAG is the tag of the API image that compose.yml runs. The default latest moves with every push to main, so name a release such as 0.6.0 to stay on it
# IMAGE_TAG=latest

# Seconds between a small query to the database and a PING to Redis, so hosted instances that pause when idle stay awake
# Set 0 to disable
KEEPALIVE_SECONDS=60

# Must be at least 32 characters, and the sample value below is refused at startup so a copied file cannot run with a public secret
JWT_SECRET_KEY=change-me-to-a-random-string-of-32-chars-or-more
JWT_ACCESS_EXPIRED_MINUTES=60
JWT_REFRESH_EXPIRED_DAYS=30
JWT_SESSION_MAX_DAYS=90
# A device that sends this token at login has its own rate limit for the email
DEVICE_TOKEN_TTL_DAYS=90

# Object storage for avatars, trash photos and class videos, leave empty to disable uploads
# Cloudflare R2 only needs S3_ACCOUNT_ID, any other S3 compatible server needs S3_ENDPOINT
# S3_PUBLIC_URL is the address that serves the objects of the bucket to anyone, because the app plays and shows them from there
# Add a lifecycle rule that expires the pending/ prefix after one day, and never one that covers videos/
# A video that a teacher uploads waits under pending/ until it is added to a class, and the rule removes the ones that never are
S3_ACCOUNT_ID=
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_ACCESS_KEY_SECRET=
S3_PUBLIC_URL=
# The photos and videos of the chat go to a second bucket that is never public, and the app reads them through signed addresses.
# It uses the same account and keys as the bucket above, so the key has to cover both. It needs the same lifecycle rule on pending/.
# Leave it empty to switch chat photos and videos off. CHAT_PHOTO_MAX_MB and CHAT_VIDEO_MAX_MB are the largest file of each kind,
# and CHAT_MEDIA_URL_SECONDS is how long a signed read address works.
S3_PRIVATE_BUCKET_NAME=
CHAT_PHOTO_MAX_MB=4
CHAT_VIDEO_MAX_MB=25
CHAT_MEDIA_URL_SECONDS=3600

# The chat socket pushes new messages to the app. CHAT_MAX_SOCKETS is how many sockets one API copy holds, and each takes some memory,
# so keep it below what the memory cap of the container allows. CHAT_MAX_SOCKETS_PER_USER is how many sockets one account keeps open.
CHAT_MAX_SOCKETS=1000
CHAT_MAX_SOCKETS_PER_USER=5

# Gamification rules
POINTS_ORGANIK=10
POINTS_ANORGANIK=15
POINTS_B3=0
TRASH_DAILY_LIMIT=5
# IDEMPOTENCY_TTL_HOURS is how long the server remembers an Idempotency-Key, so a client that was offline for a few days can still
# repeat a queued action safely. The keys are small, and rows older than this are deleted every hour.
IDEMPOTENCY_TTL_HOURS=168
# SEMESTER_START_MONTHS are the months in which a semester begins, as numbers from 1 to 12 separated by commas. On the first
# day of each of them, in APP_TIMEZONE, the leaderboard of every class starts from zero. The points of all semesters stay
SEMESTER_START_MONTHS=1,7

# Error reports. A 5xx and a panic are sent to Sentry with the error text, the stack, the route pattern, the status, the request id and
# the account id, scrubbed of emails, tokens and long numbers, and never with a request body, a header or a cookie. An empty
# SENTRY_DSN switches the reports off. The DSN is a secret in practice, so keep it in this file only. SENTRY_EVENTS_PER_MINUTE is the
# most events that leave in a minute, which keeps a crash loop from using the monthly quota. See docs/adr/0006-sentry-error-reports.md.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_SERVER_NAME=sora
# SENTRY_EVENTS_PER_MINUTE=30

# Monitoring. Alloy and its Docker socket proxy start only when COMPOSE_PROFILES holds monitoring. The values come from the
# Grafana Cloud stack, and GRAFANA_CLOUD_TOKEN is an access policy token that has the metrics:write and logs:write scopes. See docs/monitoring.md.
# COMPOSE_PROFILES=monitoring
# GRAFANA_CLOUD_PROMETHEUS_URL=https://prometheus-prod-00-prod-ap-southeast-0.grafana.net/api/prom/push
# GRAFANA_CLOUD_PROMETHEUS_USER=
# GRAFANA_CLOUD_LOKI_URL=https://logs-prod-000.grafana.net/loki/api/v1/push
# GRAFANA_CLOUD_LOKI_USER=
# GRAFANA_CLOUD_TOKEN=
# The name of this host on every metric and log line. Give each host that runs the stack its own name and keep it.
# GRAFANA_HOST=main
