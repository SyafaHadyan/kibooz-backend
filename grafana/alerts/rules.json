[
  {
    "title": "API is down",
    "ruleGroup": "kibooz",
    "folderUID": "kibooz",
    "orgID": 1,
    "for": "5m",
    "condition": "C",
    "noDataState": "Alerting",
    "execErrState": "Error",
    "isPaused": false,
    "labels": {
      "severity": "critical",
      "service": "kibooz-api"
    },
    "annotations": {
      "summary": "{{ if $labels.instance }}The metrics of the copy {{ $labels.instance }} on {{ $labels.host }} have not been scraped for 5 minutes. The API or its metrics listener is not answering{{ else }}No API metrics arrived for 5 minutes. Alloy is down or no API container is running{{ end }}"
    },
    "data": [
      {
        "refId": "A",
        "relativeTimeRange": {
          "from": 600,
          "to": 0
        },
        "datasourceUid": "__PROMETHEUS_UID__",
        "model": {
          "refId": "A",
          "expr": "min by (host, instance) (up{service=\"kibooz-api\"})",
          "instant": true,
          "intervalMs": 60000,
          "maxDataPoints": 43200
        }
      },
      {
        "refId": "B",
        "datasourceUid": "__expr__",
        "relativeTimeRange": {
          "from": 0,
          "to": 0
        },
        "model": {
          "refId": "B",
          "type": "reduce",
          "expression": "A",
          "reducer": "last",
          "settings": {
            "mode": "dropNN"
          },
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          }
        }
      },
      {
        "refId": "C",
        "datasourceUid": "__expr__",
        "relativeTimeRange": {
          "from": 0,
          "to": 0
        },
        "model": {
          "refId": "C",
          "type": "threshold",
          "expression": "B",
          "conditions": [
            {
              "evaluator": {
                "type": "lt",
                "params": [
                  1
                ]
              }
            }
          ],
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          }
        }
      }
    ]
  },
  {
    "title": "Fewer than 2 API copies are up",
    "ruleGroup": "kibooz",
    "folderUID": "kibooz",
