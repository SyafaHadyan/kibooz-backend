                  2
                ]
              }
            }
          ],
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          }
        }
      }
    ]
  },
  {
    "title": "5xx ratio is high",
    "ruleGroup": "kibooz",
    "folderUID": "kibooz",
    "orgID": 1,
    "for": "10m",
    "condition": "C",
    "noDataState": "OK",
    "execErrState": "Error",
    "isPaused": false,
    "labels": {
      "severity": "critical",
      "service": "kibooz-api"
    },
    "annotations": {
      "summary": "More than 5 percent of the requests failed with a 5xx for 10 minutes"
    },
