# The settings of the exporter of the bucket sizes, which compose.production.example.yml loads into the bucket-sizes container only. Copy
# this file to bucketsizes/.env.sizes, which git ignores, and fill it in. It is not in .env because every API container loads all of .env,
# and the key of the exporter must not be there. See docs/monitoring.md.

# The buckets to measure, separated by commas, each with an optional size at which it counts as full, such as media,chat=5GB,logs=20GB.
# A size is a number with B, KB, MB, GB or TB, and 1 GB is a thousand million bytes, the way the stores write their limits.
BUCKET_SIZES_BUCKETS=
# The address of the store, https://<account>.r2.cloudflarestorage.com for Cloudflare R2 or https://s3.<region>.amazonaws.com for AWS S3.
BUCKET_SIZES_ENDPOINT=
# A key that may list the buckets above. Listing is all it does, so give it the least that the store allows, for Cloudflare R2 an Object
# Read only token that is scoped to these buckets.
BUCKET_SIZES_ACCESS_KEY_ID=
BUCKET_SIZES_ACCESS_KEY_SECRET=
# The region of the store, auto for Cloudflare R2 and the region of the bucket for every other store.
BUCKET_SIZES_REGION=auto
# How often the buckets are listed, at least a minute. A listing is one call for each 1000 objects, which some stores charge for, so an hour
# is the default.
BUCKET_SIZES_INTERVAL=1h
