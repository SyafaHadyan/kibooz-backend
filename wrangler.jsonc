{
  // The API documentation site. Cloudflare Workers Builds runs npm run build, which turns openapi.yaml into
  // dist/index.html, and then deploys that folder as static assets. The name has to match the Workers project.
  "name": "kibooz-api-docs",
  "compatibility_date": "2026-10-07",
  "assets": {
    "directory": "./dist"
  },
  // The site is served on docs.kibooz.syafahadyan.com only, so the workers.dev address and the version URLs are off
  "workers_dev": false,
  "preview_urls": false
}
