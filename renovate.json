{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigestsToSemver"],
  "timezone": "Asia/Jakarta",
  "schedule": ["before 7am on monday"],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "rebaseWhen": "conflicted",
  "platformCommit": "enabled",
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "labels": ["dependencies"],
  "dependencyDashboard": true,
  "packageRules": [
    {
      "description": "go.mod stays on the oldest Go release the code supports for Snyk, and CI names its Go patch release by hand, see ci.yaml",
      "matchDatasources": ["golang-version"],
      "enabled": false
    },
    {
      "matchManagers": ["gomod"],
      "semanticCommitType": "chore",
      "addLabels": ["go"]
    },
    {
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "go-minor-patch"
    },
    {
      "matchManagers": ["github-actions"],
      "semanticCommitType": "ci",
      "addLabels": ["github_actions"]
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "actions"
    },
    {
      "matchManagers": ["npm"],
      "semanticCommitType": "build",
      "addLabels": ["javascript"]
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "docs-tooling"
    },
    {
      "matchManagers": ["dockerfile"],
      "semanticCommitType": "build",
      "addLabels": ["docker"]
    },
    {
      "matchManagers": ["docker-compose"],
      "semanticCommitType": "build",
      "addLabels": ["docker_compose"]
    },
    {
      "description": "the tools that CI starts from a workflow, golangci-lint, k6 and Vale, take the commit type of the workflows",
      "matchManagers": ["custom.regex"],
      "semanticCommitType": "ci",
      "addLabels": ["github_actions"]
    }
  ],
  "customManagers": [
    {
      "description": "A version in a workflow that the line above names with a renovate comment, which the bot cannot find in a run step or an action input otherwise",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*(?:version|k6-version): [\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ]
    }
  ]
}
